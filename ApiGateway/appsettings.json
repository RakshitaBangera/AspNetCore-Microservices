{
  "ReverseProxy": {
    "Routes": {
      "nameservice-route": {
        "ClusterId": "nameservice-cluster",
        "Match": {
          "Path": "/api/names/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      },

      "calculator-route": {
        "ClusterId": "calculator-cluster",
        "Match": {
          "Path": "/api/calculator/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/{**catch-all}"
          }
        ]
      }
    },

    "Clusters": {
      "nameservice-cluster": {
        "Destinations": {
          "nameservice": {
            "Address": "http://nameservice:8080/"
          }
        }
      },

      "calculator-cluster": {
        "Destinations": {
          "calculator": {
            "Address": "http://calculatorservice:8080/"
          }
        }
      }
    }
  }
}